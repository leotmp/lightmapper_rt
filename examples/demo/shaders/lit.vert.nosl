
Data :: struct
{
    positions: []vec3,
    normals: []vec3,
    uvs: []vec2,
    lm_uvs: []vec2,
    lm_chart_indices: []uint,

    lm_charts: []Chart,
    lm_chart_base: uint,

    model_to_world: mat4,
    model_to_world_normal: mat4,
    world_to_view: mat4,
    view_to_proj: mat4,
}

Chart :: struct
{
    x: vec2,
    y: vec2,
    offset: vec2,
}

Output :: struct
{
    pos: vec4 @position,
    normal: vec4 @io(0),
    uv: vec2 @io(1, centroid),
    lm_uv: vec2 @io(2, centroid),
    world_pos: vec4 @io(3),
}

main :: (vert_id: uint @vert_id, data: ^Data @data) -> Output
{
    clip_pos := vec4(data.positions[vert_id].xyz, 1.0);
    world_pos := data.model_to_world * clip_pos;
    clip_pos = data.world_to_view * world_pos;
    clip_pos = data.view_to_proj * clip_pos;
    clip_pos.y = 0.0 - clip_pos.y;

    world_normal := data.model_to_world_normal * vec4(data.normals[vert_id], 1);

    chart_idx := data.lm_chart_indices[vert_id];
    chart_base := data.lm_chart_base;
    lm_uvs := get_lm_uv(data.lm_charts[chart_base + chart_idx], data.lm_uvs[vert_id]);

    vert_out: Output;
    vert_out.pos = clip_pos;
    vert_out.normal = world_normal;
    vert_out.uv = data.uvs[vert_id];
    vert_out.lm_uv = lm_uvs;
    vert_out.world_pos = world_pos;
    return vert_out;
}

get_lm_uv :: (chart: Chart, uv: vec2) -> vec2
{
    trans_uv := uv + chart.offset;
    trans_uv /= 4096.0;
    return trans_uv;
}
